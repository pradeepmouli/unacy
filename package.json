{
  "name": "unacy-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript monorepo template with pnpm, oxlint, oxfmt, and Vitest",
  "keywords": [
    "monorepo",
    "oxfmt",
    "oxlint",
    "pnpm",
    "template",
    "typescript",
    "vitest"
  ],
  "homepage": "https://pradeepmouli.github.io/unacy/",
  "bugs": {
    "url": "https://github.com/pradeepmouli/unacy/issues"
  },
  "license": "MIT",
  "author": "Pradeep Mouli <pmouli@mac.com> (https://github.com/pradeepmouli)",
  "repository": {
    "type": "git",
    "url": "https://github.com/pradeepmouli/unacy.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "type-check": "pnpm -r run type-check",
    "typecheck:watch": "pnpm -r --parallel run type-check -- --watch",
    "clean": "pnpm -r run clean && rm -rf node_modules/.cache",
    "clean:all": "pnpm -r exec rm -rf dist node_modules && rm -rf node_modules",
    "fresh": "pnpm clean:all && pnpm install",
    "dev": "pnpm -r --parallel run dev",
    "audit": "pnpm audit --audit-level moderate",
    "outdated": "pnpm outdated -r",
    "update:deps": "pnpm update -r --latest",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm run build && changeset publish",
    "prepare": "simple-git-hooks",
    "docs:build": "pnpm --filter unacy-docs build",
    "docs:dev": "pnpm --filter unacy-docs dev"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@to-skills/vitepress": "^0.2.26",
    "@types/node": "^26.0.1",
    "@typescript/native-preview": "beta",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "oxlint-tsgolint": "^0.23.0",
    "simple-git-hooks": "^2.13.1",
    "size-limit": "^12.1.0",
    "tsx": "^4.22.4",
    "type-fest": "^5.7.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-plugin-to-skills": "^1.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "pre-push": "pnpm run type-check"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.32.0"
  },
  "packageManager": "pnpm@10.32.0",
  "pnpm": {
    "overrides": {
      "rollup": ">=4.59.0 <5"
    }
  }
}
