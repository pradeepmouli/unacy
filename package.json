{
  "name": "unacy-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript monorepo template with pnpm, oxlint, oxfmt, and Vitest",
  "keywords": [
    "monorepo",
    "oxfmt",
    "oxlint",
    "pnpm",
    "template",
    "typescript",
    "vitest"
  ],
  "homepage": "https://github.com/pradeepmouli/unacy#readme",
  "bugs": {
    "url": "https://github.com/pradeepmouli/unacy/issues"
  },
  "license": "MIT",
  "author": "Pradeep Mouli <pradeep.mouli@example.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/pradeepmouli/unacy.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "type-check": "pnpm -r run type-check",
    "typecheck:watch": "pnpm -r --parallel run type-check -- --watch",
    "clean": "pnpm -r run clean && rm -rf node_modules/.cache",
    "clean:all": "pnpm -r exec rm -rf dist node_modules && rm -rf node_modules",
    "fresh": "pnpm clean:all && pnpm install",
    "dev": "pnpm -r --parallel run dev",
    "audit": "pnpm audit --audit-level moderate",
    "outdated": "pnpm outdated -r",
    "update:deps": "pnpm update -r --latest",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm run build && changeset publish",
    "prepare": "simple-git-hooks",
    "docs": "typedoc --out docs/html --plugin typedoc-plugin-to-skills",
    "docs:md": "typedoc"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.29.8",
    "@size-limit/preset-small-lib": "^12.0.0",
    "@types/node": "^25.3.1",
    "@typescript/native-preview": "7.0.0-dev.20260321.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "oxlint-tsgolint": "^0.18.1",
    "simple-git-hooks": "^2.13.1",
    "size-limit": "^12.0.0",
    "tsx": "^4.21.0",
    "type-fest": "^5.4.4",
    "typedoc": "^0.28.17",
    "typedoc-plugin-markdown": "^4.11.0",
    "typedoc-plugin-to-skills": "^0.3.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "pre-push": "pnpm run type-check"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.6.2"
}
